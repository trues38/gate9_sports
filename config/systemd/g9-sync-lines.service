[Unit]
Description=Gate9 Full Neo4j Sync (Lines + Injuries + Relations)
After=network.target docker.service g9-data-collect.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root

# 1. Injuries 동기화 (tmp/injuries.json → Neo4j)
ExecStart=/usr/bin/docker exec gate9_sports-web bin/rails g9:sync_injuries

# 2. Game 관계 복구 (고아 노드 연결)
ExecStart=/usr/bin/docker exec gate9_sports-web bin/rails g9:sync_game_relations

# 3. SQLite → Neo4j 라인 동기화
ExecStart=/usr/bin/docker exec gate9_sports-web bin/rails g9:sync_lines

# 4. ATS/O-U 통계 업데이트
ExecStart=/usr/bin/docker exec gate9_sports-web bin/rails g9:sync_ats

# 5. TeamRegime flow_state 업데이트
ExecStart=/usr/bin/docker exec gate9_sports-web bin/rails g9:update_regime

StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
