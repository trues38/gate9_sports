<div class="px-4 py-6 space-y-8">
  <div class="flex items-center justify-between mb-2">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-th-heading uppercase font-display">
        <%= t('reports.title', default: 'Strategic Reports') %>
      </h2>
      <p class="text-[10px] text-th-muted font-black uppercase tracking-widest mt-1">Deep Quant Archives</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-400 border border-indigo-500/20">
      <iconify-icon icon="solar:document-text-bold-duotone" class="text-xl"></iconify-icon>
    </div>
  </div>

  <% if @reports.any? %>
    <div class="grid grid-cols-1 gap-4">
      <% @reports.each do |report| %>
        <%
          edge = report.edge_score&.to_i
          edge_badge_color = if edge.nil?
            nil
          elsif edge >= 75
            "bg-emerald-500/10 text-emerald-400 border-emerald-500/30"
          elsif edge >= 55
            "bg-amber-500/10 text-amber-400 border-amber-500/30"
          else
            "bg-rose-500/10 text-rose-400 border-rose-500/30"
          end
        %>
        <%= link_to report_path(report, sport: current_sport&.slug), class: "block glass-panel rounded-3xl p-6 neon-border transition-all group" do %>
          <div class="flex justify-between items-start">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <!-- FREE / PREMIUM badge -->
                <% if report.free? %>
                  <span class="inline-flex items-center gap-1 text-[9px] font-black px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 uppercase tracking-tighter">
                    <iconify-icon icon="solar:lock-unlocked-bold-duotone" width="11"></iconify-icon>
                    무료
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 text-[9px] font-black px-2 py-0.5 rounded bg-indigo-600/10 text-indigo-400 border border-indigo-500/30 uppercase tracking-tighter">
                    <iconify-icon icon="solar:lock-bold-duotone" width="11"></iconify-icon>
                    프리미엄
                  </span>
                <% end %>

                <!-- Edge score badge -->
                <% if edge_badge_color %>
                  <span class="inline-flex items-center gap-1 text-[9px] font-black px-2 py-0.5 rounded border <%= edge_badge_color %> uppercase tracking-tighter font-mono">
                    <iconify-icon icon="solar:chart-bold-duotone" width="11"></iconify-icon>
                    EDGE <%= edge %>
                  </span>
                <% end %>

                <% type_colors = { "game_analysis" => "bg-primary/10 text-primary border-primary/20", "daily_schedule" => "bg-cyan-500/10 text-cyan-400 border-cyan-500/20", "results_summary" => "bg-amber-500/10 text-amber-400 border-amber-500/20" } %>
                <span class="text-[9px] font-black px-1.5 py-0.5 rounded border uppercase tracking-tighter <%= type_colors[report.report_type] || type_colors['game_analysis'] %>"><%= report.report_type_label %></span>
                <span class="text-[10px] text-th-muted font-bold"><%= report.published_at&.in_time_zone("Asia/Seoul")&.strftime("%Y.%m.%d %H:%M KST") %></span>
              </div>
              <div class="text-lg font-display font-black text-th-heading group-hover:text-primary transition uppercase truncate"><%= report.display_title %></div>
              <% if report.free? || current_user&.can_access_premium? || session[:admin_authenticated] %>
                <div class="text-xs text-secondary font-bold mt-2 tracking-widest line-clamp-1 italic">"<%= report.pick %>"</div>
              <% else %>
                <div class="text-xs text-slate-600 font-bold mt-2 tracking-widest line-clamp-1 italic flex items-center gap-1">
                  <iconify-icon icon="solar:lock-bold-duotone" width="11" class="text-indigo-500"></iconify-icon>
                  구독 후 픽 공개
                </div>
              <% end %>
            </div>
            <div class="text-right ml-4 flex flex-col items-end gap-2">
              <div class="flex gap-0.5 text-amber-400">
                <% (report.confidence.to_i.zero? ? 3 : report.confidence.to_i).times do %>
                  <iconify-icon icon="solar:star-bold" width="12"></iconify-icon>
                <% end %>
              </div>
              <div class="w-8 h-8 rounded-full glass-panel flex items-center justify-center text-th-subtle group-hover:bg-primary/20 group-hover:text-primary transition-all">
                <iconify-icon icon="solar:arrow-right-up-linear" width="16"></iconify-icon>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="glass-panel rounded-3xl p-20 text-center border border-white/5 opacity-50">
      <iconify-icon icon="solar:ghost-bold-duotone" width="48" class="text-th-muted mx-auto mb-4"></iconify-icon>
      <p class="text-[10px] font-black text-th-muted uppercase tracking-[0.3em]"><%= t('reports.no_reports', default: 'No intelligence found') %></p>
    </div>
  <% end %>
</div>
