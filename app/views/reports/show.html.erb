<style>
  .premium-blur-wrap {
    position: relative;
    max-height: 220px;
    overflow: hidden;
  }
  .premium-blur-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 160px;
    background: linear-gradient(to bottom, transparent, rgba(2, 6, 23, 0.97));
    pointer-events: none;
  }
  .dark .premium-blur-wrap::after {
    background: linear-gradient(to bottom, transparent, rgba(2, 6, 23, 0.97));
  }
  html:not(.dark) .premium-blur-wrap::after {
    background: linear-gradient(to bottom, transparent, rgba(248, 250, 252, 0.97));
  }
</style>

<div class="max-w-4xl mx-auto space-y-10 pb-24 animate-fade-in">

  <!-- Breadcrumb & Actions -->
  <div class="flex items-center justify-between px-2">
    <%= link_to root_path(sport: current_sport&.slug), class: "inline-flex items-center gap-2 text-slate-500 hover:text-primary transition-all font-bold" do %>
      <iconify-icon icon="solar:alt-arrow-left-bold" width="18"></iconify-icon>
      <span class="text-[11px] font-black uppercase tracking-widest">Back to Dashboard</span>
    <% end %>

    <div class="flex gap-3">
      <% if @report.free? %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] font-black uppercase tracking-widest">
          <iconify-icon icon="solar:lock-unlocked-bold-duotone" width="14"></iconify-icon>
          무료 리포트
        </span>
      <% else %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600/10 border border-indigo-500/30 text-indigo-400 text-[10px] font-black uppercase tracking-widest">
          <iconify-icon icon="solar:lock-bold-duotone" width="14"></iconify-icon>
          프리미엄
        </span>
      <% end %>
      <button class="p-2.5 rounded-lg border border-[var(--border-subtle)] hover:bg-white/10 transition text-slate-500">
        <iconify-icon icon="solar:share-bold" width="18"></iconify-icon>
      </button>
    </div>
  </div>

  <!-- Hero Analysis Section -->
  <div class="card-clean p-10 bg-gradient-to-br from-indigo-600/[0.03] to-transparent">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-8 mb-10">
      <div class="space-y-4 flex-1">
        <div class="flex items-center gap-3">
          <% if @report.free? %>
            <span class="px-2 py-0.5 rounded bg-emerald-600 text-white text-[9px] font-black uppercase tracking-widest">무료 공개</span>
          <% else %>
            <span class="px-2 py-0.5 rounded bg-indigo-600 text-white text-[9px] font-black uppercase tracking-widest">Premium Intelligence</span>
          <% end %>
          <span class="text-[10px] font-bold text-slate-400 tabular-nums uppercase">Published: <%= @report.published_at&.in_time_zone("Asia/Seoul")&.strftime("%Y.%m.%d | %H:%M KST") %></span>
        </div>
        <h1 class="text-5xl font-extrabold text-[var(--text-main)] tracking-tighter leading-tight">
          <%= @report.game&.away_abbr %> @ <%= @report.game&.home_abbr %>
        </h1>
        <p class="text-xl font-medium text-slate-500 max-w-2xl leading-relaxed italic">
          <%= @report.title %>
        </p>
      </div>

      <!-- Quick Stats Stack -->
      <div class="flex flex-col gap-3 min-w-[180px]">
        <div class="card-clean p-4 border-emerald-500/20 bg-emerald-500/[0.02]">
          <div class="text-[9px] font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-1 text-center">Recorded Win Rate</div>
          <div class="text-3xl font-mono font-black text-[var(--text-main)] text-center"><%= number_with_precision(@sport_performance[:win_rate], precision: 1) %>%</div>
        </div>
        <div class="card-clean p-4">
          <div class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1 text-center">Recorded ROI</div>
          <div class="text-3xl font-mono font-black text-[var(--text-main)] text-center"><%= number_with_precision(@sport_performance[:roi], precision: 1) %>%</div>
        </div>
        <% if @report.edge_score.present? %>
          <% edge = @report.edge_score.to_i
             edge_color = edge >= 75 ? "text-emerald-400 border-emerald-500/30 bg-emerald-500/[0.04]" :
                          edge >= 55 ? "text-amber-400 border-amber-500/30 bg-amber-500/[0.04]" :
                                       "text-rose-400 border-rose-500/30 bg-rose-500/[0.04]" %>
          <div class="card-clean p-4 <%= edge_color %>">
            <div class="text-[9px] font-black uppercase tracking-widest mb-1 text-center opacity-70">Edge Score</div>
            <div class="text-3xl font-mono font-black text-center"><%= edge %></div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Execution Target (The Pick) — always visible -->
    <div class="bg-indigo-600 text-white rounded-2xl p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl shadow-indigo-600/30">
      <div class="text-center md:text-left space-y-1">
        <p class="text-[10px] font-black text-indigo-200 uppercase tracking-[0.3em]">Execution Signal</p>
        <% if @full_access %>
          <h2 class="text-4xl font-extrabold tracking-tight uppercase"><%= @report.pick %></h2>
        <% else %>
          <h2 class="text-4xl font-extrabold tracking-tight uppercase blur-sm select-none">██████</h2>
          <p class="text-[10px] text-indigo-300 mt-1">구독 후 확인 가능</p>
        <% end %>
      </div>
      <div class="h-12 w-px bg-white/10 hidden md:block"></div>
      <div class="text-center md:text-right space-y-1">
        <p class="text-[10px] font-black text-indigo-200 uppercase tracking-[0.3em]">Risk Allocation</p>
        <% if @full_access %>
          <h2 class="text-4xl font-mono font-bold tracking-tighter uppercase">1.5 UNITS</h2>
        <% else %>
          <h2 class="text-4xl font-mono font-bold tracking-tighter uppercase blur-sm select-none">██ UNITS</h2>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Primary Report Body -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start px-2">

    <!-- Content Column -->
    <div class="lg:col-span-8 space-y-8">
      <div class="flex items-center gap-4">
        <div class="h-px flex-1 bg-[var(--border-subtle)]"></div>
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.4em]">Detailed Rationale</span>
        <div class="h-px flex-1 bg-[var(--border-subtle)]"></div>
      </div>

      <% if @full_access %>
        <!-- Full content for subscribers -->
        <div class="prose prose-slate dark:prose-invert max-w-none
                    prose-p:text-lg prose-p:leading-relaxed prose-p:text-slate-600 dark:prose-p:text-slate-300
                    prose-strong:text-indigo-600 dark:prose-strong:text-indigo-400 prose-strong:font-black
                    prose-headings:font-extrabold prose-headings:tracking-tighter prose-headings:uppercase">
          <%= render_markdown(@report.content) %>
        </div>
      <% else %>
        <%
          # Calculate teaser: first ~30% of content by character count
          full_content = @report.content.to_s
          teaser_length = [(full_content.length * 0.30).to_i, 300].max
          # Try to cut at a paragraph boundary to avoid mid-sentence cuts
          teaser_cut = full_content.index("\n\n", teaser_length) || teaser_length
          teaser_content = full_content[0, teaser_cut]
        %>

        <!-- Teaser: first 30% -->
        <div class="prose prose-slate dark:prose-invert max-w-none
                    prose-p:text-lg prose-p:leading-relaxed prose-p:text-slate-600 dark:prose-p:text-slate-300
                    prose-strong:text-indigo-600 dark:prose-strong:text-indigo-400 prose-strong:font-black
                    prose-headings:font-extrabold prose-headings:tracking-tighter prose-headings:uppercase">
          <%= render_markdown(teaser_content) %>
        </div>

        <!-- Blurred remainder (visual fake with placeholder) -->
        <div class="premium-blur-wrap">
          <div class="prose prose-slate dark:prose-invert max-w-none opacity-40 pointer-events-none select-none user-select-none
                      prose-p:text-lg prose-p:leading-relaxed prose-p:text-slate-600 dark:prose-p:text-slate-300
                      prose-strong:text-indigo-600 dark:prose-strong:text-indigo-400 prose-strong:font-black
                      prose-headings:font-extrabold prose-headings:tracking-tighter prose-headings:uppercase"
               style="filter: blur(4px); user-select: none;">
            <p>이 분석에서는 팀의 최근 폼, 부상자 현황, 매치업 분석을 통해 핵심 엣지를 도출합니다. 정량적 데이터와 정성적 분석을 결합하여 최적의 베팅 포인트를 제시합니다.</p>
            <p>주요 지표 분석, 라인 무브먼트 해석, 그리고 최종 추천 픽과 유닛 사이즈까지 포함된 프리미엄 분석입니다.</p>
            <p>상세한 매치업 브레이크다운과 함께 리스크 요소 및 대안 시나리오도 다룹니다.</p>
          </div>
        </div>

        <!-- Paywall CTA -->
        <div class="relative z-10 -mt-4">
          <div class="rounded-2xl border border-indigo-500/30 bg-gradient-to-br from-indigo-950/80 via-slate-900/90 to-slate-900/80 backdrop-blur-sm p-8 shadow-2xl shadow-indigo-900/30 text-center space-y-6">

            <!-- Lock icon -->
            <div class="flex justify-center">
              <div class="w-14 h-14 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center">
                <iconify-icon icon="solar:lock-bold-duotone" class="text-indigo-400 text-3xl"></iconify-icon>
              </div>
            </div>

            <div class="space-y-2">
              <h3 class="text-xl font-black text-white uppercase tracking-tight">전체 분석 보기</h3>
              <p class="text-sm text-slate-400 max-w-sm mx-auto leading-relaxed">
                G9 AI 멀티-에이전트 풀 리포트 — 픽, 배당 분석, AI 3종 종합 의견까지 전부 공개
              </p>
            </div>

            <!-- Plan pricing -->
            <div class="grid grid-cols-3 gap-3 max-w-sm mx-auto">
              <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
                <div class="text-[10px] font-black text-slate-400 uppercase mb-1">일간</div>
                <div class="text-lg font-black text-white font-mono">3,000</div>
                <div class="text-[9px] text-slate-500">원/일</div>
              </div>
              <div class="rounded-xl border border-indigo-500/40 bg-indigo-600/10 p-3 text-center relative">
                <div class="absolute -top-2 left-1/2 -translate-x-1/2 px-2 py-0.5 bg-indigo-600 rounded text-[8px] font-black text-white uppercase whitespace-nowrap">인기</div>
                <div class="text-[10px] font-black text-indigo-300 uppercase mb-1">주간</div>
                <div class="text-lg font-black text-white font-mono">15,000</div>
                <div class="text-[9px] text-slate-500">원/주</div>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
                <div class="text-[10px] font-black text-slate-400 uppercase mb-1">월간</div>
                <div class="text-lg font-black text-white font-mono">50,000</div>
                <div class="text-[9px] text-slate-500">원/월</div>
              </div>
            </div>

            <!-- CTA buttons -->
            <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-sm mx-auto w-full">
              <%= link_to new_subscription_path,
                    class: "flex-1 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-black uppercase tracking-widest rounded-xl transition-all shadow-lg shadow-indigo-600/30 text-center" do %>
                <iconify-icon icon="solar:crown-bold-duotone" class="mr-1"></iconify-icon>
                구독하기
              <% end %>
              <% unless signed_in? %>
                <%= link_to sign_in_path,
                      class: "flex-1 py-3.5 border border-white/10 hover:border-white/20 text-slate-300 hover:text-white text-sm font-bold uppercase tracking-widest rounded-xl transition-all text-center" do %>
                  로그인
                <% end %>
              <% end %>
            </div>

            <!-- Free reports nudge -->
            <div class="pt-2 border-t border-white/5">
              <%= link_to reports_path(sport: current_sport&.slug),
                    class: "text-[11px] text-slate-500 hover:text-emerald-400 transition-colors font-bold uppercase tracking-widest" do %>
                <iconify-icon icon="solar:lock-unlocked-bold-duotone" class="mr-1 text-emerald-500"></iconify-icon>
                오늘의 무료 리포트도 확인하세요 →
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Multi-Agent Duel Mode -->
      <% if @full_access && (@report.gpt_analysis.present? || @report.gemini_analysis.present? || @report.claude_analysis.present?) %>
        <div class="mt-16 space-y-8">
          <div class="flex items-center gap-4">
            <div class="h-px flex-1 bg-primary/20"></div>
            <span class="text-[11px] font-black text-primary uppercase tracking-[0.5em] animate-pulse">AI_DUEL_MODE_ENABLED</span>
            <div class="h-px flex-1 bg-primary/20"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- GPT Codex -->
            <div class="terminal-container rounded-2xl border-white/5 hover:border-blue-500/30 transition-all group">
              <div class="terminal-header bg-blue-500/5 border-blue-500/10 px-4 py-2 flex items-center justify-between">
                <span class="text-blue-400">🤖 GPT_CODEX</span>
                <span class="text-[8px] opacity-50 font-mono">QUANT_MODEL</span>
              </div>
              <div class="p-5 space-y-4">
                <div class="text-[10px] text-slate-400 font-mono leading-relaxed h-32 overflow-y-auto custom-scrollbar">
                  <%= @report.gpt_analysis %>
                </div>
                <div class="pt-3 border-t border-white/5">
                  <p class="text-[8px] text-slate-500 uppercase mb-1">Final Verdict</p>
                  <p class="text-xs font-black text-blue-400 uppercase tracking-wider"><%= @report.gpt_pick || "UNDER_CALCULATION" %></p>
                </div>
              </div>
            </div>

            <!-- Gemini 3.0 -->
            <div class="terminal-container rounded-2xl border-primary/20 hover:border-primary/50 shadow-lg shadow-primary/5 transition-all">
              <div class="terminal-header bg-primary/10 border-primary/20 px-4 py-2 flex items-center justify-between">
                <span class="text-primary font-black italic">♊ GEMINI_3.0</span>
                <span class="text-[8px] opacity-50 font-mono">DEEP_RESEARCH</span>
              </div>
              <div class="p-5 space-y-4">
                <div class="text-[10px] text-slate-300 font-mono leading-relaxed h-32 overflow-y-auto custom-scrollbar">
                  <%= @report.gemini_analysis %>
                </div>
                <div class="pt-3 border-t border-white/5">
                  <p class="text-[8px] text-slate-500 uppercase mb-1">Final Verdict</p>
                  <p class="text-xs font-black text-primary uppercase tracking-widest"><%= @report.gemini_pick || "UNDER_CALCULATION" %></p>
                </div>
              </div>
            </div>

            <!-- Claude Code -->
            <div class="terminal-container rounded-2xl border-white/5 hover:border-amber-500/30 transition-all">
              <div class="terminal-header bg-amber-500/5 border-amber-500/10 px-4 py-2 flex items-center justify-between">
                <span class="text-amber-400">🛡️ CLAUDE_CODE</span>
                <span class="text-[8px] opacity-50 font-mono">TACTICAL_INTEL</span>
              </div>
              <div class="p-5 space-y-4">
                <div class="text-[10px] text-slate-400 font-mono leading-relaxed h-32 overflow-y-auto custom-scrollbar">
                  <%= @report.claude_analysis %>
                </div>
                <div class="pt-3 border-t border-white/5">
                  <p class="text-[8px] text-slate-500 uppercase mb-1">Final Verdict</p>
                  <p class="text-xs font-black text-amber-400 uppercase tracking-wider"><%= @report.claude_pick || "UNDER_CALCULATION" %></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Consensus Banner -->
          <% if @report.consensus_pick.present? %>
            <div class="bg-gradient-to-r from-primary/20 via-secondary/20 to-primary/20 border border-primary/30 rounded-xl p-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white">
                  <iconify-icon icon="solar:check-circle-bold" class="text-lg"></iconify-icon>
                </div>
                <div>
                  <p class="text-[9px] font-black text-primary uppercase tracking-widest leading-none mb-1">Consensus Pick Achieved</p>
                  <p class="text-sm font-black text-white uppercase"><%= @report.consensus_pick %></p>
                </div>
              </div>
              <span class="text-[8px] font-mono text-primary/60">CONFIDENCE_LEVEL: HIGH</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Verified Badge -->
      <% if @full_access %>
        <div class="pt-12 border-t border-[var(--border-subtle)] flex items-center justify-between opacity-50 italic">
          <div class="flex items-center gap-2">
            <iconify-icon icon="solar:shield-check-bold" class="text-emerald-500 text-xl"></iconify-icon>
            <span class="text-xs font-bold text-[var(--text-main)]">G9 Intelligence Verification Complete</span>
          </div>
          <span class="text-[10px] font-bold font-mono">HASH_ID: <%= SecureRandom.hex(6).upcase %></span>
        </div>
      <% end %>
    </div>

    <!-- Sidebar Info -->
    <div class="lg:col-span-4 space-y-6">
      <div class="card-clean p-6 space-y-6">
        <h3 class="text-xs font-black text-[var(--text-main)] uppercase tracking-[0.2em] border-b border-[var(--border-subtle)] pb-4 flex items-center gap-2">
          <iconify-icon icon="solar:graph-bold-duotone" class="text-indigo-500"></iconify-icon>
          Market Variables
        </h3>

        <div class="space-y-4">
          <div class="flex justify-between items-end">
            <span class="text-[10px] font-bold text-slate-400 uppercase">Home Spread</span>
            <span class="text-sm font-mono font-bold text-[var(--text-main)]"><%= @report.game&.home_spread.present? ? (@report.game.home_spread > 0 ? "+#{@report.game.home_spread}" : @report.game.home_spread) : '--' %></span>
          </div>
          <div class="flex justify-between items-end">
            <span class="text-[10px] font-bold text-slate-400 uppercase">Total O/U</span>
            <span class="text-sm font-mono font-bold text-[var(--text-main)]"><%= @report.game&.total_line || '--' %></span>
          </div>
          <% if @report.edge_score.present? %>
            <% edge = @report.edge_score.to_i
               bar_width = [[edge, 0].max, 100].min
               bar_color = edge >= 75 ? "bg-emerald-500" : edge >= 55 ? "bg-amber-500" : "bg-rose-500"
               label_color = edge >= 75 ? "text-emerald-400" : edge >= 55 ? "text-amber-400" : "text-rose-400" %>
            <div class="pt-2">
              <div class="flex justify-between items-end mb-1.5">
                <span class="text-[10px] font-bold text-slate-400 uppercase">Edge Score</span>
                <span class="text-sm font-mono font-black <%= label_color %>"><%= edge %></span>
              </div>
              <div class="h-1.5 rounded-full bg-white/5 overflow-hidden">
                <div class="h-full rounded-full <%= bar_color %> transition-all" style="width: <%= bar_width %>%"></div>
              </div>
            </div>
          <% end %>
          <div class="pt-4 border-t border-[var(--border-subtle)]">
            <span class="text-[10px] font-bold text-slate-400 uppercase block mb-3 text-center tracking-widest">Recent Results</span>
            <% if @recent_results.any? %>
              <div class="space-y-2">
                <% @recent_results.each do |result_report| %>
                  <% result_style =
                    case result_report.result
                    when "win" then "text-emerald-400"
                    when "loss" then "text-rose-400"
                    else "text-slate-300"
                    end %>
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-400"><%= result_report.pick.presence || result_report.title&.truncate(20) || "Report" %></span>
                    <span class="font-black uppercase <%= result_style %>"><%= result_report.result %></span>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center font-black text-indigo-600 dark:text-indigo-400 uppercase tracking-tighter">
                Results pending
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Disclosure -->
      <div class="px-2">
        <p class="text-[10px] text-slate-500 leading-relaxed text-center">
          G9 Intelligence 리포트는 고도의 알고리즘 연산을 통해 생성됩니다. 과거의 성과가 미래의 수익을 보장하지 않습니다. <strong>철저한 자금 관리(Bankroll)를 권장합니다.</strong>
        </p>
      </div>
    </div>

  </div>
</div>
