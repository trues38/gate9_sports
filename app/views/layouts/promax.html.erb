<!DOCTYPE html>
<html class="h-full" data-controller="theme" data-theme-mode-value="<%= cookies[:theme] || 'dark' %>">
  <head>
    <title>GATE9 SPORTS | PROMAX</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Outfit', sans-serif; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@2.3.0/dist/iconify-icon.min.js"></script>
  </head>

  <body class="h-full relative overflow-x-hidden selection:bg-neon-blue selection:text-white
               bg-cosmos-950 text-white
               light:bg-gray-50 light:text-gray-900 transition-colors duration-300"
        data-theme-target="body">
    
    <!-- Ambient Background (Dark Mode Only) -->
    <div class="fixed inset-0 pointer-events-none z-0 light:hidden">
        <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-neon-blue/20 rounded-full blur-[100px] animate-pulse"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] bg-neon-purple/20 rounded-full blur-[100px] animate-pulse"></div>
    </div>

    <!-- Main Container -->
    <div class="relative z-10 flex flex-col h-full max-w-lg mx-auto min-h-screen
                border-x border-white/5 light:border-gray-200
                bg-black/20 backdrop-blur-sm light:bg-white light:backdrop-blur-none transition-colors">
      
      <!-- Promax Header -->
      <header class="sticky top-0 z-50 px-4 pt-4 pb-2 mb-2 bg-gradient-to-b from-cosmos-950 to-transparent light:from-gray-50 light:to-transparent">
        <div class="glass-dark light:bg-white light:shadow-md light:border-gray-200 rounded-full px-5 py-3 flex justify-between items-center shadow-lg shadow-cosmos-900/50 light:shadow-gray-200/50 transition-all">
          <h1 class="text-xl font-bold tracking-tight light:text-gray-900">
            GATE9 <span class="text-neon-cyan drop-shadow-md light:text-indigo-600 light:drop-shadow-none">PRO</span>
          </h1>
          
          <div class="flex items-center gap-3">
             <!-- Theme Toggle Button -->
             <button data-action="click->theme#toggle" class="p-2 rounded-full hover:bg-white/10 light:hover:bg-gray-100 transition-colors text-white light:text-gray-600">
                <iconify-icon icon="solar:sun-bold" class="w-5 h-5 hidden light:block"></iconify-icon>
                <iconify-icon icon="solar:moon-bold" class="w-5 h-5 block light:hidden"></iconify-icon>
             </button>

             <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-neon-blue to-neon-purple light:from-indigo-500 light:to-purple-500 flex items-center justify-center border border-white/20 light:border-transparent shadow-lg text-white">
                <span class="text-xs font-bold">JS</span>
             </div>
          </div>
        </div>

        <!-- Sport Tabs (Floating) -->
        <nav class="mt-4 flex gap-2 overflow-x-auto pb-2 scrollbar-hide px-1">
            <% [["basketball", "농구"], ["baseball", "야구"], ["soccer", "축구"]].each do |slug, name| %>
            <% is_active = (params[:sport] || 'basketball') == slug %>
            <%= link_to promax_sport_path(sport: slug), 
                class: "px-4 py-2 rounded-2xl text-sm font-semibold transition-all duration-300 whitespace-nowrap #{is_active ? 'bg-gradient-to-r from-neon-blue to-neon-purple text-white shadow-lg shadow-neon-blue/25 light:shadow-indigo-500/30' : 'glass-panel light:bg-white light:border-gray-200 light:shadow-sm text-gray-400 light:text-gray-500 hover:text-white light:hover:text-gray-900 hover:bg-white/5 light:hover:bg-gray-50'}" do %>
                <%= name %>
            <% end %>
            <% end %>
        </nav>
      </header>

      <!-- Main Content -->
      <main class="flex-1 px-4 pb-24">
        <%= yield %>
      </main>

      <!-- Promax Tab Bar -->
      <nav class="fixed bottom-6 left-4 right-4 z-50 max-w-lg mx-auto">
        <div class="glass-dark light:bg-white light:border-gray-200 light:shadow-xl rounded-3xl p-2 flex justify-around items-center shadow-2xl shadow-black/50 border-t border-white/10 transition-colors">
          <% [
              ['calendar-bold', 'Schedule', promax_path],
              ['document-text-bold', 'Reports', '#'],
              ['lightbulb-bolt-bold', 'Insights', '#'],
              ['user-circle-bold', 'Profile', '#']
             ].each do |icon, label, path| %>
             <% is_active = current_page?(path) %>
             <%= link_to path, class: "relative p-3 rounded-2xl transition-all duration-300 group #{is_active ? 'bg-white/10 light:bg-indigo-50 text-white light:text-indigo-600' : 'text-gray-500 hover:text-gray-300 light:hover:text-gray-700'}" do %>
                <iconify-icon icon="solar:<%= icon %>" width="24" class="transition-transform group-hover:scale-110 <%= is_active ? 'text-neon-cyan light:text-indigo-600 drop-shadow-[0_0_8px_rgba(6,182,212,0.5)] light:drop-shadow-none' : '' %>"></iconify-icon>
                <% if is_active %>
                    <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-neon-cyan light:bg-indigo-600 rounded-full"></span>
                <% end %>
             <% end %>
          <% end %>
        </div>
      </nav>

    </div>
  </body>
</html>
