<!DOCTYPE html>
<html class="h-full dark" data-controller="theme" data-theme-mode-value="<%= cookies[:theme] || 'dark' %>">
  <head>
    <title><%= content_for(:title) || t('app_name', default: "G9 AI Analysis") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700;800&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
    <!-- Iconify를 헤더에서 가장 먼저 로드 -->
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-screen flex flex-col md:flex-row overflow-hidden antialiased bg-[var(--bg-main)]" data-theme-target="body">
    
    <!-- Mobile Header -->
    <div class="md:hidden h-14 flex-shrink-0 flex items-center justify-between px-4 bg-[var(--bg-sidebar)] border-b border-[var(--th-border)] z-50">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded bg-primary flex items-center justify-center text-white">
          <iconify-icon icon="solar:chart-2-bold-duotone" class="text-sm"></iconify-icon>
        </div>
        <span class="font-display text-lg font-bold tracking-tighter text-white uppercase italic"><%= t('app_logo', default: 'G9 AI') %></span>
      </div>
      <button class="text-white p-2" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
        <iconify-icon icon="solar:hamburger-menu-bold" class="text-2xl"></iconify-icon>
      </button>
    </div>

    <!-- Sidebar: Fixed Navigation -->
    <aside id="mobile-menu" class="hidden md:flex w-full md:w-64 flex-shrink-0 flex-col bg-[var(--bg-sidebar)] border-b md:border-b-0 md:border-r border-[var(--th-border)] z-40 absolute md:relative h-[calc(100vh-3.5rem)] md:h-full top-14 md:top-0">
      <div class="hidden md:flex h-20 items-center px-8 border-b border-white/5">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-primary flex items-center justify-center text-white">
            <iconify-icon icon="solar:chart-2-bold-duotone" class="text-xl"></iconify-icon>
          </div>
          <span class="font-display text-xl font-bold tracking-tighter text-white uppercase italic"><%= t('app_logo', default: 'G9 AI') %></span>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto py-8">
        <!-- 1. Sectors -->
        <nav class="mb-10">
          <p class="px-8 text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4"><%= t('terminal.sectors', default: 'Sectors') %></p>
          <% sports.each do |sport| %>
            <% 
              icon_name = case sport.slug
                when 'basketball' then 'solar:basketball-bold-duotone'
                when 'soccer'     then 'solar:football-bold-duotone'
                when 'baseball'   then 'solar:target-bold-duotone'
                else 'solar:globus-bold-duotone'
              end
            %>
            <%= link_to root_path(sport: sport.slug), class: "sidebar-item #{current_sport&.slug == sport.slug ? 'sidebar-item-active' : ''}" do %>
              <iconify-icon icon="<%= icon_name %>" class="text-xl"></iconify-icon>
              <span class="text-xs font-bold uppercase"><%= sport.name %></span>
            <% end %>
          <% end %>
        </nav>

        <!-- 2. My Area -->
        <nav class="pt-8 border-t border-white/5">
          <p class="px-8 text-[10px] font-black text-slate-500 uppercase tracking-widest mb-4"><%= t('terminal.account', default: 'Account') %></p>
          <%= link_to profile_path, class: "sidebar-item" do %>
            <iconify-icon icon="solar:folder-favourite-bold-duotone" class="text-xl opacity-60"></iconify-icon>
            <span class="text-xs font-bold uppercase"><%= t('terminal.my_library', default: 'My Library') %></span>
          <% end %>
          <%= link_to insights_path(sport: current_sport&.slug), class: "sidebar-item" do %>
            <iconify-icon icon="solar:bolt-circle-bold-duotone" class="text-xl opacity-60"></iconify-icon>
            <span class="text-xs font-bold uppercase"><%= t('terminal.market_news', default: 'Market News') %></span>
          <% end %>
          <%= link_to performance_path, class: "sidebar-item #{request.path == performance_path ? 'sidebar-item-active' : ''}" do %>
            <iconify-icon icon="solar:chart-bold-duotone" class="text-xl opacity-60"></iconify-icon>
            <span class="text-xs font-bold uppercase">실적 공개</span>
          <% end %>
        </nav>
      </div>

      <!-- Footer: User -->
      <div class="p-6 border-t border-white/5 bg-black/20">
        <% if signed_in? %>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-9 h-9 rounded-full bg-slate-800 border border-white/10 flex items-center justify-center text-primary relative shadow-inner">
              <iconify-icon icon="solar:user-bold-duotone" class="text-lg"></iconify-icon>
              <div class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-[#020617] rounded-full"></div>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-white truncate"><%= current_user.email.split('@').first %></p>
              <p class="text-[8px] font-black text-slate-500 uppercase"><%= t('terminal.premium_member', default: 'Premium Member') %></p>
            </div>
          </div>
          <%= button_to t('terminal.logout', default: 'LOGOUT'), sign_out_path, method: :delete, class: "w-full py-2 text-[9px] font-black text-slate-500 hover:text-red-400 uppercase tracking-[0.2em] transition-colors" %>
        <% else %>
          <%= link_to t('terminal.access_terminal', default: 'ACCESS_TERMINAL'), sign_in_path, class: "block w-full py-3 bg-primary text-white text-[9px] font-black text-center uppercase tracking-widest rounded-lg shadow-lg shadow-primary/20" %>
        <% end %>
      </div>
    </aside>

    <!-- Main Workspace -->
    <main class="flex-1 flex flex-col overflow-hidden relative z-10 w-full">
      <header class="h-16 flex-shrink-0 flex items-center justify-between px-10 bg-[var(--bg-card)] border-b border-[var(--th-border)]">
        <div class="flex items-center gap-4">
          <h1 class="text-xl font-display font-bold text-[var(--th-heading)] uppercase tracking-tight italic">
            <%= current_sport&.name %> <span class="mx-3 text-[var(--th-border)] not-italic">/</span> <%= t('nav.dashboard', default: 'DASHBOARD') %>
          </h1>
        </div>

        <div class="flex items-center gap-6">
          <div class="flex items-center gap-4 border-r border-[var(--th-border)] pr-6">
            <div class="flex bg-black/5 dark:bg-white/5 rounded-lg p-0.5 border border-[var(--th-border)]">
              <%= link_to "KO", url_for(params.to_unsafe_h.merge(locale: :ko)), class: "px-3 py-1 text-[10px] font-black rounded #{I18n.locale == :ko ? 'bg-primary text-white shadow-sm' : 'text-slate-500'}" %>
              <%= link_to "EN", url_for(params.to_unsafe_h.merge(locale: :en)), class: "px-3 py-1 text-[10px] font-black rounded #{I18n.locale == :en ? 'bg-primary text-white shadow-sm' : 'text-slate-500'}" %>
            </div>
            <button data-action="click->theme#toggle" class="w-8 h-8 flex items-center justify-center text-slate-400 hover:text-primary transition-colors">
              <iconify-icon icon="solar:sun-bold-duotone" class="text-xl block dark:hidden"></iconify-icon>
              <iconify-icon icon="solar:moon-bold-duotone" class="text-xl hidden dark:block"></iconify-icon>
            </button>
          </div>
          <div class="hidden md:flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 text-[10px] font-bold uppercase tracking-tighter">
            <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
            <%= t('terminal.system_online', default: 'System_Online') %>
          </div>
        </div>
      </header>

      <div class="flex-1 overflow-y-auto p-10">
        <div class="max-w-6xl mx-auto">
          <%= yield %>
        </div>
      </div>
    </main>

  </body>
</html>
