<div class="space-y-6 pb-12">
  <!-- Date Navigation / Terminal Header -->
  <div class="terminal-container rounded-md">
    <div class="terminal-header">
      <span><%= t('terminal.analysis_schedule', default: 'G9 ANALYSIS SCHEDULE') %></span>
      <span class="text-neutral"><%= t('terminal.scanning_date', default: 'SCANNING_DATE') %>: <%= @selected_date.strftime("%Y-%m-%d") %></span>
    </div>
    
    <div class="flex items-center justify-between p-2 bg-black/5 dark:bg-white/[0.02]">
      <div class="flex gap-2 p-1 glass-panel rounded-lg">
        <% [
          [Date.current - 1.day, t('schedule.yesterday', default: 'PREV')],
          [Date.current, t('schedule.today', default: 'LIVE')],
          [Date.current + 1.day, t('schedule.tomorrow', default: 'NEXT')]
        ].each do |date, label| %>
          <% is_selected = @selected_date == date %>
          <%= link_to schedule_index_index_path(sport: current_sport&.slug, date: date, filter: @filter),
              class: "px-6 py-1.5 rounded text-[10px] font-mono font-black uppercase transition-all #{is_selected ? 'bg-primary text-white shadow-md' : 'text-th-muted hover:text-th-heading hover:bg-white/5'}" do %>
            <%= label %>
          <% end %>
        <% end %>
      </div>

      <div class="flex items-center gap-4 px-4">
        <%= link_to schedule_index_index_path(sport: current_sport&.slug, date: @yesterday, filter: @filter), class: "text-th-muted hover:text-primary transition" do %>
          <iconify-icon icon="solar:alt-arrow-left-bold" width="18"></iconify-icon>
        <% end %>
        <span class="text-xs font-mono font-bold text-th-heading"><%= @selected_date.strftime("%b %d, %Y") %></span>
        <%= link_to schedule_index_index_path(sport: current_sport&.slug, date: @tomorrow, filter: @filter), class: "text-th-muted hover:text-primary transition" do %>
          <iconify-icon icon="solar:alt-arrow-right-bold" width="18"></iconify-icon>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Global League Filter -->
  <div class="flex items-center gap-4 px-1 border-b border-[var(--th-border)] pb-1">
    <%= link_to schedule_index_index_path(sport: current_sport&.slug, date: @selected_date), class: "pb-3 px-1 border-b-2 font-mono text-[10px] font-black uppercase tracking-widest transition-all #{params[:league].blank? ? 'border-primary text-primary' : 'border-transparent text-th-muted hover:text-th-heading'}" do %>
      <%= t('terminal.all_streams', default: 'ALL_STREAMS') %>
    <% end %>
    <% available_leagues.each do |league| %>
      <% is_active = params[:league] == league[:slug] %>
      <%= link_to schedule_index_index_path(sport: current_sport&.slug, date: @selected_date, league: league[:slug]), class: "pb-3 px-1 border-b-2 font-mono text-[10px] font-black uppercase tracking-widest transition-all #{is_active ? 'border-primary text-primary' : 'border-transparent text-th-muted hover:text-th-heading'}" do %>
        <%= league[:slug].upcase %>
      <% end %>
    <% end %>
  </div>

  <!-- Bloomberg Style Schedule Grid -->
  <div class="terminal-container rounded-lg border-2 border-[var(--th-border)]">
    <table class="w-full text-left border-collapse">
      <thead class="bg-black/5 dark:bg-white/5 text-[9px] font-mono text-th-muted uppercase tracking-widest border-b border-[var(--th-border)]">
        <tr>
          <th class="px-4 py-3 font-bold w-20"><%= t('terminal.status', default: 'STATUS') %></th>
          <th class="px-4 py-3 font-bold w-20 text-center"><%= t('terminal.time', default: 'TIME') %></th>
          <th class="px-4 py-3 font-bold"><%= t('terminal.matchup', default: 'MATCHUP') %></th>
          <th class="px-4 py-3 font-bold text-center"><%= t('terminal.line', default: 'LINE') %></th>
          <th class="px-4 py-3 font-bold text-center"><%= t('terminal.total', default: 'TOTAL') %></th>
          <th class="px-4 py-3 font-bold text-center"><%= t('terminal.intel_level', default: 'CONFIDENCE') %></th>
          <th class="px-4 py-3 font-bold text-right"><%= t('terminal.action', default: 'ACTION') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--th-border)] font-mono">
        <% if @games.any? %>
          <% @games.each do |game| %>
            <tr class="data-row transition-colors">
              <td class="px-4 py-4">
                <% status = game_status(game) %>
                <% if status == :finished %>
                  <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-white/5 text-th-muted border border-white/10 uppercase"><%= t('terminal.final') %></span>
                <% elsif status == :live %>
                  <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 uppercase animate-pulse"><%= t('terminal.live') %></span>
                <% else %>
                  <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20 uppercase"><%= t('terminal.upcoming', default: '예정') %></span>
                <% end %>
              </td>
              <td class="px-4 py-4 text-center">
                <span class="text-[10px] text-th-heading font-bold"><%= game.game_date.strftime("%H:%M") %></span>
              </td>
              <td class="px-4 py-4">
                <div class="flex items-center gap-3">
                  <span class="text-sm font-bold text-th-heading tracking-tighter uppercase"><%= game.away_abbr %> @ <%= game.home_abbr %></span>
                  <% if game.schedule_note.present? %>
                    <span class="text-[8px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-500 font-black cursor-help" title="<%= game.schedule_note %>">!</span>
                  <% end %>
                </div>
              </td>
              <td class="px-4 py-4 text-center">
                <span class="text-xs text-neutral font-bold"><%= game.home_spread.present? ? (game.home_spread > 0 ? "+#{game.home_spread}" : game.home_spread) : '--' %></span>
              </td>
              <td class="px-4 py-4 text-center">
                <span class="text-xs text-alert font-bold"><%= game.total_line || '--' %></span>
              </td>
              <td class="px-4 py-4 text-center">
                <% report = game.reports.published.last %>
                <% if report %>
                  <div class="flex gap-0.5 justify-center">
                    <% (report.confidence.to_i.zero? ? 3 : report.confidence.to_i).times do %>
                      <div class="w-1 h-1 bg-positive rounded-full"></div>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-[8px] text-th-muted/40"><%= t('terminal.no_data', default: 'NO_DATA') %></span>
                <% end %>
              </td>
              <td class="px-4 py-4 text-right">
                <% if report %>
                  <div class="flex items-center justify-end gap-2">
                    <% if report.free? %>
                      <span class="text-[8px] font-black px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 uppercase">FREE</span>
                    <% else %>
                      <span class="text-[8px] font-black px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/30 uppercase">PRO</span>
                    <% end %>
                    <%= link_to report_path(report, sport: current_sport&.slug), class: "inline-block px-3 py-1 rounded-sm border border-primary/30 text-primary text-[9px] font-black uppercase hover:bg-primary hover:text-white transition-all" do %>
                      <%= t('terminal.read_intel', default: 'READ_INTEL') %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-[9px] text-th-muted/30 font-bold uppercase tracking-widest italic"><%= t('terminal.queued', default: 'QUEUED') %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="px-4 py-24 text-center opacity-30">
              <iconify-icon icon="solar:ghost-bold-duotone" width="32" class="mb-2 mx-auto"></iconify-icon>
              <div class="text-[10px] font-black uppercase tracking-[0.3em]"><%= t('terminal.no_flux_data', default: 'No data found') %></div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
