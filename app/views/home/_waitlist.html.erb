<!-- Waitlist Section: Email Collection -->
<section id="waitlist" class="relative -mx-10 mb-16">
  <!-- Background Pattern -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-secondary/5"></div>
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(255,255,255,.1) 35px, rgba(255,255,255,.1) 70px);"></div>

  <div class="relative max-w-6xl mx-auto px-10 py-20">
    <div class="glass-card rounded-3xl p-12 border-2 border-primary/20 relative overflow-hidden">
      <!-- Accent Glow -->
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-primary/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-secondary/20 rounded-full blur-3xl"></div>

      <div class="relative max-w-3xl mx-auto text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/30 mb-6">
          <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
          <span class="text-[10px] font-black text-primary uppercase tracking-widest">한정 1000명 얼리버드</span>
        </div>

        <!-- Headline -->
        <h2 class="text-4xl md:text-5xl font-display font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-white to-slate-400 mb-4 leading-tight">
          MVP 출시 알림 신청
        </h2>

        <p class="text-lg text-slate-400 mb-8 leading-relaxed">
          퀀트급 NBA 분석 리포트를 가장 먼저 받아보세요.<br/>
          <span class="text-sm text-slate-500">프리미엄: ₩20,000+/월 | 스탠다드: ₩10-15,000/월</span>
        </p>

        <!-- Email Form -->
        <%= form_with url: subscribe_home_path, method: :post, local: true, class: "max-w-lg mx-auto" do |f| %>
          <div class="flex flex-col sm:flex-row gap-3 mb-6">
            <div class="flex-1 relative group">
              <div class="absolute inset-0 bg-gradient-to-r from-primary to-secondary rounded-xl blur opacity-20 group-focus-within:opacity-40 transition-opacity"></div>
              <%= f.email_field :email,
                  placeholder: "이메일 주소 입력",
                  required: true,
                  class: "relative w-full px-6 py-4 rounded-xl bg-black/40 border-2 border-white/10 text-white placeholder:text-slate-500 focus:border-primary focus:outline-none transition-all font-medium" %>
            </div>
            <%= f.submit "신청하기",
                class: "px-8 py-4 rounded-xl bg-gradient-to-r from-primary to-secondary text-white font-black uppercase tracking-widest text-sm shadow-lg shadow-primary/30 hover:scale-105 hover:shadow-primary/50 active:scale-95 transition-all cursor-pointer" %>
          </div>

          <!-- Privacy Note -->
          <div class="flex items-start gap-2 text-left max-w-md mx-auto">
            <iconify-icon icon="solar:shield-check-bold-duotone" class="text-emerald-500 text-lg flex-shrink-0 mt-0.5"></iconify-icon>
            <p class="text-xs text-slate-500 leading-relaxed">
              이메일은 리포트 발송 용도로만 사용됩니다. 스팸 발송 없음, 언제든 구독 해지 가능.
            </p>
          </div>
        <% end %>

        <!-- Stats Bar -->
        <div class="grid grid-cols-3 gap-6 mt-12 pt-8 border-t border-white/10">
          <div class="text-center">
            <p class="text-3xl font-display font-black text-primary mb-1">70%</p>
            <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest">분석 비중</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-display font-black text-secondary mb-1">3</p>
            <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest">AI 에이전트</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-display font-black text-emerald-500 mb-1">10+</p>
            <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest">년 경험</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
