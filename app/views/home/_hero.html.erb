<!-- Hero Section: Conversion-Focused -->
<section class="relative overflow-hidden -mx-10 -mt-10 mb-16">
  <!-- Background: Gradient Mesh with Noise -->
  <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-slate-900 to-cyan-900/20 dark:from-purple-900/30 dark:via-black dark:to-cyan-900/30"></div>
  <div class="absolute inset-0 opacity-[0.015] dark:opacity-[0.025]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 400 400%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>

  <!-- Geometric Accent Lines -->
  <div class="absolute top-0 left-1/4 w-px h-full bg-gradient-to-b from-transparent via-primary/20 to-transparent"></div>
  <div class="absolute top-0 right-1/3 w-px h-full bg-gradient-to-b from-transparent via-secondary/20 to-transparent"></div>

  <div class="relative max-w-6xl mx-auto px-10 pt-24 pb-32">
    <!-- Eyebrow -->
    <div class="flex items-center gap-3 mb-6 animate-fade-in">
      <div class="w-12 h-[2px] bg-gradient-to-r from-primary to-transparent"></div>
      <span class="text-[9px] font-black text-primary uppercase tracking-[0.4em]">업계 최초 NotebookLM 퀀트급 AI</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-6xl md:text-7xl lg:text-8xl font-display font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-white via-slate-100 to-slate-400 leading-[0.9] mb-8 animate-fade-in max-w-4xl" style="animation-delay: 0.1s">
      NBA 베팅의<br/>
      새로운 기준,<br/>
      <span class="text-primary neon-text">퀀트급</span> <span class="text-secondary">AI 분석</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-xl md:text-2xl text-slate-300 dark:text-slate-400 font-medium max-w-3xl mb-12 leading-relaxed animate-fade-in" style="animation-delay: 0.2s">
      NotebookLM 퀀트 리포트 + 3-AI 픽스터 + 실시간 정보<br/>
      <span class="text-slate-500 text-lg">10년+ 베팅 경험 기반, 정보 제공 서비스</span>
    </p>

    <!-- Value Props: 3 Cards -->
    <div class="grid md:grid-cols-3 gap-4 mb-12 animate-fade-in" style="animation-delay: 0.3s">
      <!-- Prop 1: Quant Analysis -->
      <div class="group relative glass-card p-6 rounded-2xl border border-primary/20 hover:border-primary/40 transition-all hover:scale-[1.02]">
        <div class="absolute -top-3 -left-3 w-16 h-16 bg-gradient-to-br from-primary/20 to-transparent rounded-full blur-2xl group-hover:blur-3xl transition-all"></div>
        <div class="relative">
          <div class="w-12 h-12 rounded-xl bg-primary/10 border border-primary/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <iconify-icon icon="solar:graph-up-bold-duotone" class="text-2xl text-primary"></iconify-icon>
          </div>
          <h3 class="text-sm font-black text-white uppercase tracking-wider mb-2">퀀트급 분석</h3>
          <p class="text-xs text-slate-400 leading-relaxed">업계 최초 NotebookLM 딥러닝 리포트. 헤지펀드 수준의 데이터 분석</p>
          <div class="mt-3 px-3 py-1 bg-primary/10 border border-primary/20 rounded-full inline-block">
            <span class="text-[9px] font-black text-primary uppercase tracking-widest">Industry First</span>
          </div>
        </div>
      </div>

      <!-- Prop 2: 3-AI Agents -->
      <div class="group relative glass-card p-6 rounded-2xl border border-secondary/20 hover:border-secondary/40 transition-all hover:scale-[1.02]">
        <div class="absolute -top-3 -right-3 w-16 h-16 bg-gradient-to-br from-secondary/20 to-transparent rounded-full blur-2xl group-hover:blur-3xl transition-all"></div>
        <div class="relative">
          <div class="w-12 h-12 rounded-xl bg-secondary/10 border border-secondary/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <iconify-icon icon="solar:cpu-bolt-bold-duotone" class="text-2xl text-secondary"></iconify-icon>
          </div>
          <h3 class="text-sm font-black text-white uppercase tracking-wider mb-2">AI 에이전트 3개</h3>
          <p class="text-xs text-slate-400 leading-relaxed">Claude + GPT + Gemini 동시 분석. 리스크 분산, 정확도 극대화</p>
          <div class="mt-3 flex gap-1">
            <div class="w-2 h-2 rounded-full bg-secondary/60 animate-pulse"></div>
            <div class="w-2 h-2 rounded-full bg-secondary/60 animate-pulse" style="animation-delay: 0.2s"></div>
            <div class="w-2 h-2 rounded-full bg-secondary/60 animate-pulse" style="animation-delay: 0.4s"></div>
          </div>
        </div>
      </div>

      <!-- Prop 3: Real-time Hedging -->
      <div class="group relative glass-card p-6 rounded-2xl border border-emerald-500/20 hover:border-emerald-500/40 transition-all hover:scale-[1.02]">
        <div class="absolute -bottom-3 -right-3 w-16 h-16 bg-gradient-to-br from-emerald-500/20 to-transparent rounded-full blur-2xl group-hover:blur-3xl transition-all"></div>
        <div class="relative">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <iconify-icon icon="solar:clock-circle-bold-duotone" class="text-2xl text-emerald-500"></iconify-icon>
          </div>
          <h3 class="text-sm font-black text-white uppercase tracking-wider mb-2">실시간 해징 정보</h3>
          <p class="text-xs text-slate-400 leading-relaxed">라인 변동, 부상 뉴스, 라인업 변경 실시간 업데이트</p>
          <div class="mt-3 flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
            <span class="text-[9px] font-black text-emerald-500 uppercase tracking-widest">Live</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-8 animate-fade-in" style="animation-delay: 0.4s">
      <%= link_to reports_path(sport: current_sport&.slug || 'basketball'), class: "group inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-primary to-secondary text-white font-black uppercase tracking-widest text-sm shadow-2xl shadow-primary/30 hover:scale-105 hover:shadow-primary/50 active:scale-95 transition-all" do %>
        <iconify-icon icon="solar:document-text-bold-duotone" class="text-xl"></iconify-icon>
        <span>샘플 리포트 보기</span>
        <iconify-icon icon="solar:alt-arrow-right-bold" class="text-lg group-hover:translate-x-1 transition-transform"></iconify-icon>
      <% end %>

      <a href="#waitlist" class="group inline-flex items-center gap-3 px-8 py-4 rounded-2xl glass-card border-2 border-white/20 text-white font-black uppercase tracking-widest text-sm hover:border-white/40 hover:bg-white/5 transition-all">
        <iconify-icon icon="solar:letter-bold-duotone" class="text-xl"></iconify-icon>
        <span>무료 체험 시작</span>
        <iconify-icon icon="solar:arrow-down-bold" class="text-lg group-hover:translate-y-1 transition-transform"></iconify-icon>
      </a>
    </div>

    <!-- Social Proof Badge -->
    <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full glass-card border border-amber-500/30 animate-fade-in" style="animation-delay: 0.5s">
      <div class="flex -space-x-2">
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-purple-700 border-2 border-slate-900 flex items-center justify-center">
          <iconify-icon icon="solar:verified-check-bold" class="text-xs text-white"></iconify-icon>
        </div>
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-secondary to-cyan-700 border-2 border-slate-900 flex items-center justify-center">
          <iconify-icon icon="solar:medal-star-bold" class="text-xs text-white"></iconify-icon>
        </div>
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-500 to-green-700 border-2 border-slate-900 flex items-center justify-center">
          <iconify-icon icon="solar:chart-2-bold" class="text-xs text-white"></iconify-icon>
        </div>
      </div>
      <div class="text-left">
        <p class="text-xs font-black text-amber-400 uppercase tracking-wider">10년+ 베팅 경험 기반</p>
        <p class="text-[10px] text-slate-500 font-medium">정보 제공 서비스 (70% 분석 / 30% 픽)</p>
      </div>
    </div>
  </div>
</section>
