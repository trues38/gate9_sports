<div class="space-y-6 pb-12">
  <!-- Dashboard Header -->
  <div class="terminal-container rounded-md">
    <div class="terminal-header">
      <span>G9 AI 오늘의 경기</span>
      <span class="text-neutral"><%= @today.strftime("%Y-%m-%d (%a)") %></span>
    </div>
  </div>

  <% if @sports_with_games.any? %>
    <% @sports_with_games.each do |entry| %>
      <% sport = entry[:sport] %>
      <% games = entry[:games] %>

      <!-- Sport Section -->
      <div class="terminal-container rounded-lg border-2 border-[var(--th-border)]">
        <!-- Sport Header -->
        <div class="flex items-center justify-between px-4 py-3 bg-black/5 dark:bg-white/5 border-b border-[var(--th-border)]">
          <div class="flex items-center gap-3">
            <span class="text-lg"><%= sport.icon %></span>
            <span class="text-xs font-mono font-black uppercase tracking-widest text-th-heading"><%= sport.name %></span>
            <span class="text-[9px] font-mono text-th-muted bg-white/5 px-2 py-0.5 rounded"><%= games.size %>경기</span>
          </div>
          <%= link_to schedule_index_index_path(sport: sport.slug),
              class: "text-[9px] font-mono font-bold text-primary hover:text-primary/80 uppercase tracking-wider transition" do %>
            전체 보기 →
          <% end %>
        </div>

        <!-- Games Table -->
        <table class="w-full text-left border-collapse">
          <thead class="text-[9px] font-mono text-th-muted uppercase tracking-widest border-b border-[var(--th-border)]">
            <tr>
              <th class="px-4 py-2 font-bold w-16">상태</th>
              <th class="px-4 py-2 font-bold w-16 text-center">시간</th>
              <th class="px-4 py-2 font-bold">매치업</th>
              <th class="px-4 py-2 font-bold text-center">핸디</th>
              <th class="px-4 py-2 font-bold text-center">토탈</th>
              <th class="px-4 py-2 font-bold text-right">분석</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--th-border)] font-mono">
            <% games.each do |game| %>
              <tr class="data-row transition-colors">
                <td class="px-4 py-3">
                  <% status = game_status(game) %>
                  <% if status == :finished %>
                    <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-white/5 text-th-muted border border-white/10 uppercase">종료</span>
                  <% elsif status == :live %>
                    <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 uppercase animate-pulse">LIVE</span>
                  <% else %>
                    <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20 uppercase">예정</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class="text-[10px] text-th-heading font-bold"><%= game.game_date.in_time_zone("Asia/Seoul").strftime("%H:%M") %></span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <span class="text-sm font-bold text-th-heading tracking-tighter uppercase"><%= game.away_abbr %> @ <%= game.home_abbr %></span>
                    <% if game.schedule_note.present? %>
                      <span class="text-[8px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-500 font-black cursor-help" title="<%= game.schedule_note %>">!</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class="text-xs text-neutral font-bold"><%= game.home_spread.present? ? (game.home_spread > 0 ? "+#{game.home_spread}" : game.home_spread) : '--' %></span>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class="text-xs text-alert font-bold"><%= game.total_line || '--' %></span>
                </td>
                <td class="px-4 py-3 text-right">
                  <% report = game.reports.select { |r| r.status == "published" }.last %>
                  <% if report %>
                    <%= link_to report_path(report, sport: sport.slug), class: "inline-block px-3 py-1 rounded-sm border border-primary/30 text-primary text-[9px] font-black uppercase hover:bg-primary hover:text-white transition-all" do %>
                      리포트 읽기
                    <% end %>
                  <% else %>
                    <span class="text-[9px] text-th-muted/30 font-bold uppercase tracking-widest italic">분석 예약됨</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <div class="terminal-container rounded-lg border-2 border-[var(--th-border)] py-24 text-center opacity-30">
      <iconify-icon icon="solar:ghost-bold-duotone" width="32" class="mb-2 mx-auto"></iconify-icon>
      <div class="text-[10px] font-black uppercase tracking-[0.3em]">오늘 예정된 경기가 없습니다</div>
    </div>
  <% end %>

  <!-- Recent Reports -->
  <% if @recent_reports.any? %>
    <div class="terminal-container rounded-lg border-2 border-[var(--th-border)]">
      <div class="flex items-center justify-between px-4 py-3 bg-black/5 dark:bg-white/5 border-b border-[var(--th-border)]">
        <span class="text-xs font-mono font-black uppercase tracking-widest text-th-heading">최신 리포트</span>
        <%= link_to reports_path(sport: "basketball"),
            class: "text-[9px] font-mono font-bold text-primary hover:text-primary/80 uppercase tracking-wider transition" do %>
          전체 보기 →
        <% end %>
      </div>
      <div class="divide-y divide-[var(--th-border)]">
        <% @recent_reports.each do |report| %>
          <% sport_slug = report.game&.sport&.slug || "basketball" %>
          <%= link_to report_path(report, sport: sport_slug), class: "flex items-center justify-between px-4 py-3 hover:bg-white/5 transition-colors" do %>
            <div class="flex items-center gap-3">
              <span class="text-[8px] font-black px-1.5 py-0.5 rounded uppercase
                <%= case report.report_type
                    when 'daily_schedule' then 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
                    when 'results_summary' then 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                    else 'bg-violet-500/10 text-violet-400 border border-violet-500/20'
                    end %>">
                <%= report.report_type_label %>
              </span>
              <span class="text-xs font-mono text-th-heading font-bold"><%= report.display_title %></span>
            </div>
            <span class="text-[9px] font-mono text-th-muted"><%= report.published_at&.in_time_zone("Asia/Seoul")&.strftime("%m/%d %H:%M") %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
